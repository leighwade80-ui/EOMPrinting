<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish > FolderProfile in Visual Studio builds a ready-to-run copy of EOM Printing in bin\Publish.
  Self-contained: the PCs don't need .NET installed. 32-bit (win-x86) for the Jet engine that reads PackProd.mdb.
  Not single-file or trimmed: the report viewer compiles report expressions at run time and needs its DLLs on disk.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>bin\Publish\</PublishDir>
    <DeleteExistingFiles>true</DeleteExistingFiles>
  </PropertyGroup>
</Project>
