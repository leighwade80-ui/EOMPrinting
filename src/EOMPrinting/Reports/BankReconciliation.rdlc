                    <Value>=IIf((((Code.Nz(First(Fields!OpeningBalance.Value, "Main")) - Code.Nz(First(Fields!Unpresented.Value, "Main"))) - Code.Nz(First(Fields!CashBookValue.Value, "Main")) + Code.Nz(First(Fields!ReceiptBookValue.Value, "Main"))) - (Code.Nz(First(Fields!ClosingBalance.Value, "Main")) - Code.Nz(First(Fields!UnpresentedChequesValue.Value, "Main")))) &lt;&gt; 0, "ERROR", "MAGIC")</Value>
                    <Style>
                      <FontFamily>Arial</FontFamily>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <Color>=IIf((((Code.Nz(First(Fields!OpeningBalance.Value, "Main")) - Code.Nz(First(Fields!Unpresented.Value, "Main"))) - Code.Nz(First(Fields!CashBookValue.Value, "Main")) + Code.Nz(First(Fields!ReceiptBookValue.Value, "Main"))) - (Code.Nz(First(Fields!ClosingBalance.Value, "Main")) - Code.Nz(First(Fields!UnpresentedChequesValue.Value, "Main")))) &lt;&gt; 0, "Red", "Green")</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Center</TextAlign>
                </Style>
